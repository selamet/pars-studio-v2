  "manifesto": {
    "section": "001",
    "label": "STÜDYO HAKKINDA",
    "image": "/images/studio/about.jpg",
    "imageCaption": "PARS STUDIOS · İSTANBUL · 41.0082°N",
    "heading": "İyi ses bir tesadüf değil; bir karardır.",
    "p1": "Pars Studios, İstanbul'da kurulu bağımsız bir prodüksiyon stüdyosudur. Tek bir işle ilgileniriz: bir fikri, dinleyenin göğsünde hissedeceği bir kayda dönüştürmek. Trend kovalamayız; karakter inşa ederiz.",
    "p2": "Her proje akustikten önce niyetle başlar. Sanatçıyla oturur, parçanın ne söylemek istediğini konuşur, ancak ondan sonra mikrofonu açarız. Aceleyi sevmeyiz — çünkü acele, kayıtta duyulur.",
    "p3": "Donanım önemlidir, kulak daha çok. Burada ekipman bir araçtır, kahraman değil. Sonuçta geriye kalan tek şey vardır: parça çaldığında odadaki sessizlik."
  },
  "services": {
    "section": "002",
    "label": "HİZMETLER",
    "heading": "Hizmetler",
    "items": [
      {
        "no": "01",
        "name": "Kayıt",
        "desc": "Analog hattan dijitale, gürültüsüz ve doğru sinyal zinciriyle tracking. Vokal, enstrüman ve canlı oda kaydı."
      },
      {
        "no": "02",
        "name": "Miks",
        "desc": "Parçaya derinlik, alan ve denge kazandıran detaylı miks. Stem teslimat ve revizyon dahil."
      },
      {
        "no": "03",
        "name": "Mastering",
        "desc": "Yayın platformlarına hazır, tutarlı ve şeffaf mastering. Dijital ve fiziksel formatlar için optimizasyon."
      },
      {
        "no": "04",
        "name": "Beat Prodüksiyon",
        "desc": "Sanatçının dünyasına özel, sıfırdan kurgulanan prodüksiyon. Trap, drill, R&B, alternatif."
      },
      {
        "no": "05",
        "name": "Vokal Prodüksiyon",
        "desc": "Performans yönetimi, comp, tuning ve estetik karar. Vokali parçanın merkezine oturtmak."
      }
    ]
  },
