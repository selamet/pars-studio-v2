# ─────────────────────────────────────────────
# Pars Studio — environment variables (Next.js frontend)
# All data, auth, payments and email live in the Django API (pars-studio-api).
# Copy this file to `.env.local` locally; set the same variables in Vercel.
# ─────────────────────────────────────────────

# Django API origin. Local: http://localhost:8000 · Prod: https://api.studiospars.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public media host (R2 public bucket domain) so next/image may load covers, e.g. media.studiospars.com
NEXT_PUBLIC_MEDIA_HOST=

# Public site URL, used for absolute links and metadata.
# Local: http://localhost:3000  ·  Prod: https://studiospars.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
