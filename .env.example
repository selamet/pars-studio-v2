# ─────────────────────────────────────────────
# Pars Studio — environment variables
# Part 1 (landing page) needs NONE of these.
# Part 2 (booking system + admin) needs all of them.
# Copy this file to `.env.local` and fill in real values.
# Add the SAME variables in the Vercel project settings before deploying.
# ─────────────────────────────────────────────

# Supabase — project URL + keys (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
# Service role key — SERVER ONLY. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Resend — transactional email
RESEND_API_KEY=re_xxxxxxxx
# "From" address. The domain MUST be verified in Resend before sending.
# A @gmail.com address will NOT work here.
RESEND_FROM_EMAIL=Pars Studios <booking@pars-studios.com>
# Where studio-owner notifications are delivered (any inbox, incl. Gmail).
STUDIO_NOTIFICATION_EMAIL=parsstudiosofficial@gmail.com
# Optional: where customer replies should land. Defaults to
# STUDIO_NOTIFICATION_EMAIL if unset.
REPLY_TO_EMAIL=parsstudiosofficial@gmail.com

# Public site URL — used to build absolute links inside emails.
# Local: http://localhost:3000  ·  Prod: https://parsstudio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
